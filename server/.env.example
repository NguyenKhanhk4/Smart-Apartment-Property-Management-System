# ===== Core (bắt buộc) =====
NODE_ENV=development
PORT=5000
# Chuỗi kết nối MongoDB Atlas (xin leader qua kênh riêng). Nhớ thêm tên database sau ".net/":
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sapms_dev_<tên>?retryWrites=true&w=majority
MONGODB_URI=
# Origin của frontend cho CORS, nhiều origin thì phân tách bằng dấu phẩy
CLIENT_URL=http://localhost:5173
# Chuỗi ngẫu nhiên >= 16 ký tự. Tạo nhanh:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d

# ===== Dành cho các module (SRS mục 14) =====
# Module nào dùng biến nào thì bỏ comment và thêm validate vào src/config/env.js
# payOS (Mô đun 4 — Người 3): lấy ở my.payos.vn → Kênh thanh toán. Thiếu thì tắt thanh toán online.
# PAYOS_CLIENT_ID=
# PAYOS_API_KEY=
# PAYOS_CHECKSUM_KEY=
# PAYOS_RETURN_URL=http://localhost:5173/r/payments/result
# PAYOS_CANCEL_URL=http://localhost:5173/r/payments/result
# Bỏ trống RETURN/CANCEL → mặc định <CLIENT_URL>/r/payments/result.
# Webhook: khai trên my.payos.vn URL public <backend>/api/payments/payos/webhook (dev: ngrok http 5000).
# Không có webhook vẫn chạy được: trang kết quả và cron 5 phút tự hỏi payOS để gạch nợ.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# Khóa mã hóa CCCD 32 byte dạng base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
ID_ENCRYPTION_KEY=

# ===== Bảo mật =====
# Đăng nhập nhanh không mật khẩu (/api/dev) — chỉ có tác dụng khi NODE_ENV=development
# ENABLE_DEV_AUTH=true
# Swagger UI (/api-docs) — mặc định tắt khi NODE_ENV=production
# ENABLE_SWAGGER=false
# Giới hạn gọi API đăng nhập / đăng ký / làm mới token theo IP
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_MINUTES=15
