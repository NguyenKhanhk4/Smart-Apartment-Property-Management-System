# ===== Core (bắt buộc) =====
NODE_ENV=development
PORT=5000
# Chuỗi kết nối MongoDB Atlas (xin leader qua kênh riêng). Nhớ thêm tên database sau ".net/":
# mongodb+srv://<user>:<password>@cluster0.35xugwt.mongodb.net/sapms_dev_<tên>?retryWrites=true&w=majority
MONGODB_URI=
# Origin của frontend cho CORS, nhiều origin thì phân tách bằng dấu phẩy
CLIENT_URL=http://localhost:5173
# Chuỗi ngẫu nhiên >= 16 ký tự. Tạo nhanh:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ===== Dành cho các module (SRS mục 14) =====
# Module nào dùng biến nào thì bỏ comment và thêm validate vào src/config/env.js
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
# VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# VNPAY_RETURN_URL=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
